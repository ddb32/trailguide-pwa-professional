# TrailGuide PWA - Environment Configuration Template
# Copy this file to .env.development for local development

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Application URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
PUBLIC_URL=http://localhost:5173

# =============================================================================
# DATABASE CONFIGURATION  
# =============================================================================

# PostgreSQL Database Settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trailguide_dev
DB_USER=trailguide
DB_PASSWORD=secure_dev_password_2024

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-64-characters-for-production-security
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# AWS S3 Configuration (for image uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=trailguide-images-dev
S3_BASE_URL=https://your-bucket.s3.amazonaws.com

# Local Storage (fallback for development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@trailguide.app

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Analytics Settings
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# =============================================================================
# PWA CONFIGURATION
# =============================================================================

# Service Worker
SW_ENABLED=true
CACHE_NAME=trailguide-pwa-v1

# Offline Configuration
OFFLINE_FALLBACK_PAGE=/offline.html

# =============================================================================
# LOCALIZATION
# =============================================================================

# Default Language
DEFAULT_LANGUAGE=he
SUPPORTED_LANGUAGES=he,en

# RTL Support
RTL_ENABLED=true

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Development Flags
DEBUG=true
HOT_RELOAD=true
SOURCE_MAPS=true

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs