# TrailGuide Docker Hub Deployment Configuration
# Copy this file to .env.production and configure your values

# ===========================================
# DOCKER HUB CONFIGURATION
# ===========================================
DOCKER_HUB_USERNAME=horenalon
API_VERSION=latest
FRONTEND_VERSION=latest

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=trailguide_prod
POSTGRES_USER=trailguide
POSTGRES_PASSWORD=test_secure_password_123

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PASSWORD=your_secure_redis_password_here

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Generate with: openssl rand -hex 64
JWT_SECRET=test_jwt_secret_for_docker_hub_testing_only_not_for_production_use_128_characters_long_secret_key_12345678901234567890
JWT_EXPIRES_IN=24h

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Your domain configuration
CORS_ORIGIN=https://way2party.co.il
VITE_API_URL=https://api.way2party.co.il
VITE_DOMAIN=way2party.co.il
VITE_SECURE=true

# Alternative for localhost development
# CORS_ORIGIN=http://localhost
# VITE_API_URL=http://localhost:3000
# VITE_DOMAIN=localhost
# VITE_SECURE=false

# ===========================================
# PORT CONFIGURATION
# ===========================================
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443

# ===========================================
# HEBREW/RTL CONFIGURATION
# ===========================================
DEFAULT_LANGUAGE=he
TIMEZONE=Asia/Jerusalem
VITE_APP_NAME=TrailGuide
VITE_DEFAULT_LANGUAGE=he
VITE_ENABLE_RTL=true

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
LOG_LEVEL=info
ENABLE_METRICS=true

# ===========================================
# PRODUCTION SECURITY HEADERS
# ===========================================
# These are configured automatically in production
# HSTS_MAX_AGE=31536000
# CSP_REPORT_URI=https://your-domain.com/api/v1/csp-report
# FEATURE_POLICY_ENABLED=true