# TrailGuide PWA - Production Environment Configuration Template
# IMPORTANT: Copy this file to .env.production and update all values for production

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment - MUST be 'production'
NODE_ENV=production
PORT=3000

# Application URLs - UPDATE THESE FOR YOUR DOMAIN
FRONTEND_URL=https://your-domain.com
API_URL=https://api.your-domain.com
PUBLIC_URL=https://your-domain.com
DOMAIN=your-domain.com

# =============================================================================
# DATABASE CONFIGURATION - CRITICAL: UPDATE ALL DATABASE CREDENTIALS
# =============================================================================

# PostgreSQL Database Settings - CHANGE ALL VALUES
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=trailguide_prod
DB_USER=trailguide_prod_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20

# =============================================================================
# AUTHENTICATION & SECURITY - CRITICAL: GENERATE NEW SECRETS
# =============================================================================

# JWT Configuration - CRITICAL: Generate new secret for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_CRYPTOGRAPHICALLY_SECURE_SECRET_64_CHARS_MINIMUM
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=14

# Session Configuration - CRITICAL: Generate new secret
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_SECURE_SESSION_SECRET

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL Certificate Paths (if using local certificates)
SSL_CERT_PATH=/path/to/ssl/certificate.crt
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CA_PATH=/path/to/ssl/ca-bundle.crt

# Force HTTPS redirects
FORCE_HTTPS=true

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# AWS S3 Configuration for production file storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=trailguide-images-prod
S3_BASE_URL=https://your-bucket.s3.amazonaws.com

# File Upload Limits
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/secure/uploads/path

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# API Rate Limiting - More restrictive for production
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=30
LOGIN_RATE_LIMIT_MAX=3

# CORS Configuration - Restrict to your domains only
CORS_ORIGIN=https://your-domain.com

# Security Headers
HSTS_MAX_AGE=31536000
CSP_REPORT_URI=https://your-domain.com/api/v1/security/csp-report

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings for production emails
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-production-email@your-domain.com
SMTP_PASS=your-secure-email-password
FROM_EMAIL=noreply@your-domain.com

# Email Security
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=true

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Analytics Settings
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/trailguide/app.log
ERROR_LOG_FILE=/var/log/trailguide/error.log
SECURITY_LOG_FILE=/var/log/trailguide/security.log

# External Monitoring (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

# =============================================================================
# DATABASE SECURITY
# =============================================================================

# Database SSL Configuration
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=/path/to/db-ca-certificate.crt

# Connection Security
DB_CONNECTION_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=trailguide-backups-prod

# File Backup
FILE_BACKUP_ENABLED=true
FILE_BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis Configuration for production caching
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_TTL=3600

# Cache Settings
CACHE_ENABLED=true
CACHE_PREFIX=trailguide_prod

# =============================================================================
# CONTENT DELIVERY NETWORK
# =============================================================================

# CDN Configuration for static assets
CDN_ENABLED=true
CDN_BASE_URL=https://cdn.your-domain.com
CDN_API_KEY=your-cdn-api-key

# =============================================================================
# LOCALIZATION - PRODUCTION
# =============================================================================

# Default Language
DEFAULT_LANGUAGE=he
SUPPORTED_LANGUAGES=he,en

# RTL Support
RTL_ENABLED=true

# Translation Service (optional)
TRANSLATION_SERVICE_API_KEY=your-translation-api-key

# =============================================================================
# PRODUCTION OPTIMIZATIONS
# =============================================================================

# Performance Settings
COMPRESSION_ENABLED=true
GZIP_LEVEL=6
ETAG_ENABLED=true

# Static Asset Caching
STATIC_CACHE_MAX_AGE=31536000  # 1 year
API_CACHE_MAX_AGE=300          # 5 minutes

# =============================================================================
# SECURITY COMPLIANCE
# =============================================================================

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for compliance

# Data Retention
USER_DATA_RETENTION_DAYS=2555   # 7 years
ANALYTICS_DATA_RETENTION_DAYS=1095  # 3 years

# Privacy
GDPR_COMPLIANCE=true
ANONYMIZE_IPS=true

# =============================================================================
# HEALTH CHECKS & MONITORING
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Monitoring URLs
HEALTH_CHECK_URL=https://api.your-domain.com/api/v1/health
MONITORING_WEBHOOK=https://your-monitoring-service.com/webhook

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================

# 1. NEVER commit this file with real credentials to version control
# 2. Generate unique, cryptographically secure secrets for all secret values
# 3. Use environment-specific values for all URLs and endpoints
# 4. Enable SSL/TLS for all connections in production
# 5. Regularly rotate secrets and certificates
# 6. Monitor security logs and set up alerting
# 7. Use least-privilege principles for all database and service accounts
# 8. Enable audit logging for compliance requirements
# 9. Set up automated backups with encryption
# 10. Test disaster recovery procedures regularly

# For generating secure secrets, use:
# JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PASSWORD: openssl rand -base64 32