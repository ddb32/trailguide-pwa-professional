# TrailGuide PWA - Production Environment for way2party.co.il
# PRODUCTION DEPLOYMENT CONFIGURATION

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Domain Configuration for way2party.co.il
DOMAIN_NAME=way2party.co.il
FRONTEND_URL=https://way2party.co.il
API_URL=https://way2party.co.il/api
PUBLIC_URL=https://way2party.co.il

# =============================================================================
# DATABASE CONFIGURATION - UPDATE THESE VALUES
# =============================================================================

# PostgreSQL Database Settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trailguide_production
DB_USER=trailguide_prod
DB_PASSWORD=HkCf2HLWdnmkiwkSHai8OC46s

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20

# Database SSL (enable for production)
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=false

# =============================================================================
# AUTHENTICATION & SECURITY - GENERATE NEW SECRETS
# =============================================================================

# JWT Configuration - CRITICAL: Generate new secret for production
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=8a1126f7749e27dea901227d606690c17bd7de818c379fe465f61a8584b984a610dd2d091350ed0e0d28a90e379431de6cd0e14c00cb8ad3419d3107c26b2e46
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=14

# Session Configuration - CRITICAL: Generate new secret
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=86021bd26d55c6295cac963afb3632862b18260166ab4a59f1f164914787ddf7

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL Certificate Configuration
SSL_EMAIL=admin@way2party.co.il
SSL_CERT_PATH=/etc/letsencrypt/live/way2party.co.il/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/way2party.co.il/privkey.pem

# Force HTTPS redirects
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=rjuLvjNBETVKDMhO2jsd
REDIS_DB=0
REDIS_TTL=3600

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Local Storage (production uploads)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

# AWS S3 Configuration (optional for scaling)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-west-1
S3_BUCKET_NAME=way2party-uploads
S3_BASE_URL=https://way2party-uploads.s3.eu-west-1.amazonaws.com

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# API Rate Limiting (production values)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=30
LOGIN_RATE_LIMIT_MAX=3

# CORS Configuration
CORS_ORIGIN=https://way2party.co.il

# Security Headers
CSP_REPORT_URI=https://way2party.co.il/api/v1/security/csp-report

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=notifications@way2party.co.il
SMTP_PASS=JzgnwO5iTYBhSK6v
FROM_EMAIL=noreply@way2party.co.il

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Analytics Settings
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log
ERROR_LOG_FILE=/app/logs/error.log
SECURITY_LOG_FILE=/app/logs/security.log

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# LOCALIZATION - HEBREW SUPPORT
# =============================================================================

# Default Language (Hebrew for Israeli market)
DEFAULT_LANGUAGE=he
SUPPORTED_LANGUAGES=he,en

# RTL Support
RTL_ENABLED=true

# =============================================================================
# PRODUCTION OPTIMIZATIONS
# =============================================================================

# Performance Settings
COMPRESSION_ENABLED=true
GZIP_LEVEL=6
ETAG_ENABLED=true

# Cache Settings
STATIC_CACHE_MAX_AGE=31536000
API_CACHE_MAX_AGE=300

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=way2party-backups

# =============================================================================
# SECURITY COMPLIANCE
# =============================================================================

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# Data Retention
USER_DATA_RETENTION_DAYS=2555
ANALYTICS_DATA_RETENTION_DAYS=1095

# =============================================================================
# IMPORTANT SETUP INSTRUCTIONS
# =============================================================================

# 1. REPLACE ALL "GENERATE_*_HERE" VALUES WITH SECURE SECRETS
# 2. UPDATE DATABASE PASSWORD AND CREDENTIALS
# 3. CONFIGURE DNS A RECORD: way2party.co.il -> [SERVER_IP]
# 4. RUN SSL SETUP: ./deploy/ssl-setup.sh
# 5. TEST DEPLOYMENT: https://way2party.co.il/health

# Generate secrets with these commands:
# JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DB_PASSWORD: openssl rand -base64 32
# REDIS_PASSWORD: openssl rand -base64 24