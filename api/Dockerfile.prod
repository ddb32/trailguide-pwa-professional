# Multi-stage build for production
FROM node:18-alpine AS dependencies

# Set working directory
WORKDIR /app

# Copy package files for better caching
COPY package*.json ./

# Install dependencies (cache this layer)
RUN npm ci --only=production && npm cache clean --force

# Build stage
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Copy dependencies from previous stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source code
COPY . .

# Verify the application structure
RUN ls -la src/ && node --version

# Production stage
FROM node:18-alpine AS production

# Create app user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S trailguide -u 1001

# Set working directory
WORKDIR /app

# Update package index and install system dependencies
RUN apk update && \
    apk add --no-cache \
        curl \
        tzdata \
        dumb-init \
        ca-certificates \
        bash && \
    rm -rf /var/cache/apk/* && \
    update-ca-certificates

# Set timezone to Israel
ENV TZ=Asia/Jerusalem
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Copy package files
COPY --from=builder /app/package*.json ./

# Copy production dependencies from dependencies stage (better caching)
COPY --from=dependencies /app/node_modules ./node_modules

# Copy built application
COPY --from=builder --chown=trailguide:nodejs /app/src ./src
COPY --from=builder --chown=trailguide:nodejs /app/migrations ./migrations

# Create directories with proper permissions
RUN mkdir -p /app/uploads /app/logs && \
    chown -R trailguide:nodejs /app/uploads /app/logs && \
    chmod 755 /app/uploads /app/logs

# Set production environment
ENV NODE_ENV=production

# Switch to non-root user
USER trailguide

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/api/v1/health || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "src/app.js"]